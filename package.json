{
  "name": "derma-triage",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "proxy": "node server/proxy.js",
    "build": "vite build",
    "preview": "vite preview",
    "console:server": "node console/server.js",
    "console:web": "vite --config console/web/vite.config.js",
    "console:build": "vite build --config console/web/vite.config.js",
    "ml:config": "ml/.venv/bin/python ml/config.py",
    "ml:manifest": "ml/.venv/bin/python ml/dermnet_adapter.py",
    "ml:smoke": "ml/.venv/bin/python ml/train.py --smoke",
    "ml:train": "ml/.venv/bin/python ml/train.py",
    "ml:kaggle": "ml/.venv/bin/python ml/kaggle/launch.py",
    "ml:eval": "ml/.venv/bin/python ml/evaluate.py",
    "ml:predict": "ml/.venv/bin/python ml/predict.py",
    "gen:symptoms": "ml/.venv/bin/python ml/gen_symptom_rules.py",
    "test:conformance": "node tests/conformance.mjs && ml/.venv/bin/python tests/conformance_py.py",
    "check": "node tests/conformance.mjs && ml/.venv/bin/python tests/conformance_py.py && node tests/column_coverage.mjs && node tests/client_path.mjs && node tests/shortcircuit_path.mjs && ml/.venv/bin/python ml/check_surfaces.py --check && ml/.venv/bin/python ml/check_wiring.py --check && ml/.venv/bin/python ml/gen_symptom_rules.py --check"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "express": "^4.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.3.1"
  }
}
